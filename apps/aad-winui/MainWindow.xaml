<Window
    x:Class="Aad.WinUi.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Aad.WinUi"
    Title="MynaCAD">
    <Grid x:Name="ShellRoot" Language="en-US" Loaded="OnLoaded" PreviewKeyDown="OnShellKey" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptLive" Width="0" Height="0" Opacity="0" IsHitTestVisible="False" AutomationProperties.Name="Command prompt" />
        <StackPanel Orientation="Vertical">
        <!-- Open drawings and the take-off switch: a strip above the menu. -->
        <Border x:Name="DocTabsHost" Background="{ThemeResource AppBackgroundBrush}" Padding="{StaticResource PaddingDocTabs}" AutomationProperties.Name="Open drawings strip">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                    <StackPanel x:Name="DrawingTabs" Orientation="Horizontal" Spacing="{StaticResource SpaceXs}" AutomationProperties.Name="Open drawings" />
                    <ToggleButton
                        x:Name="TakeoffModeButton"
                        Content="Take-off"
                        MinHeight="{StaticResource ControlHeight}"
                        FontSize="{StaticResource FontSizeCaption}"
                        Padding="{StaticResource PaddingControl}"
                        Click="OnTakeoffMode"
                        AutomationProperties.Name="Take-off mode"
                        ToolTipService.ToolTip="Take-off mode: shows the take-off tools (walls, beams, floors, record to MynaOps)" />
                </StackPanel>
            </ScrollViewer>
        </Border>
        <MenuBar
            x:Name="Bar"
            Style="{StaticResource ShellMenuBarStyle}"
            Background="{ThemeResource SurfaceBrush}"
            FontSize="{StaticResource FontSizeBody}"
            AutomationProperties.Name="Menu" />
        </StackPanel>
        <!-- Layer selector. Draw, modify, annotate and the discipline tools are the left column. -->
        <StackPanel Grid.Row="1" Orientation="Vertical">
        <Border x:Name="ToolStripHost" Style="{StaticResource ToolStripChromeStyle}" BorderThickness="0,0,0,1" AutomationProperties.Name="Drawing and architecture tools" AutomationProperties.LandmarkType="Navigation">
            <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" Margin="{StaticResource PaddingSm}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMd}" VerticalAlignment="Center" AutomationProperties.Name="Layer">
                        <TextBlock Text="Layer" FontSize="{StaticResource FontSizeCaption}" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <ComboBox
                            x:Name="LayerBox"
                            MinWidth="{StaticResource LayerStateComboWidth}"
                            MaxWidth="{StaticResource LayerComboMaxWidth}"
                            MinHeight="{StaticResource ControlHeight}"
                            VerticalAlignment="Center"
                            SelectionChanged="OnLayerPicked"
                            AutomationProperties.Name="Current layer"
                            ToolTipService.ToolTip="Current layer (while a sheet-set tab is active, the layers of that tab)" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
        </StackPanel>
        <!-- Take-off tools on their own row (Classic take-off mode). -->
        <Border x:Name="TakeoffToolStripHost" Grid.Row="2" Style="{StaticResource ToolStripChromeStyle}" BorderThickness="0,0,0,1" Visibility="Collapsed" AutomationProperties.Name="Take-off tools" AutomationProperties.LandmarkType="Navigation">
            <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                <StackPanel x:Name="TakeoffBar" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center" Height="{StaticResource IconButtonSize}" Margin="{StaticResource PaddingSm}" />
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="3">
            <!-- Tools | canvas | splitter | properties (right). -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailColumn" Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="{StaticResource FieldWidth}" />
                <ColumnDefinition x:Name="LeftSplitterColumn" Width="Auto" />
                <ColumnDefinition x:Name="PropertiesColumn" Width="{StaticResource SidePanelColumnWidth}" MinWidth="0" />
            </Grid.ColumnDefinitions>
            <!-- Tools down the left side, two to a row: draw, modify, annotate, then the architecture tools. The drawing tabs are across the top. -->
            <Border x:Name="ToolColumnHost" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,0,1,0" AutomationProperties.Name="Tools">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Vertical" Spacing="{StaticResource SpaceXs}" Margin="{StaticResource PaddingSm}">
                        <Border x:Name="ToolStripSlot" />
                        <Border x:Name="ArchToolsDivider" Height="{StaticResource DividerThickness}" Margin="{StaticResource MarginArchDivider}" Background="{ThemeResource BorderSubtleBrush}" Visibility="Collapsed" />
                        <Border x:Name="ArchBarSlot" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <!-- The drawing with its tabs: sheet tabs above, level tabs below; the active tab takes the canvas colour so they read as one piece. -->
            <Grid x:Name="CanvasColumn" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
            <Border x:Name="TabRowHost" Grid.Row="0" Background="{ThemeResource SurfaceBrush}" BorderThickness="0" Padding="{StaticResource PaddingTabRow}" AutomationProperties.Name="Drawing tabs">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TabRow" Orientation="Horizontal" Spacing="{StaticResource SpaceXs}" />
                </ScrollViewer>
            </Border>
                <Border x:Name="CanvasHost" Grid.Row="1" Background="{ThemeResource CanvasBackgroundBrush}" SizeChanged="OnCanvasSize" AutomationProperties.Name="Drawing" />
            <!-- Level tabs run along the bottom edge of the drawing; the active tab joins it. -->
            <Border x:Name="LevelBarHost" Grid.Row="2" Background="{ThemeResource SurfaceStatusBrush}" BorderThickness="0" Padding="{StaticResource PaddingLevelBar}" AutomationProperties.Name="Levels">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                        <StackPanel x:Name="LevelTabs" Orientation="Horizontal" Spacing="{StaticResource SpaceXs}" AutomationProperties.Name="Level tabs" />
                        <Button x:Name="AddLevelButton" Click="OnAddLevel" AutomationProperties.Name="Add level" ToolTipService.ToolTip="Add a level" Style="{StaticResource IconButtonStyle}">
                            <local:DrawnIcon Kind="plus" />
                        </Button>
                        <Button x:Name="LevelsButton" Click="OnLevelsWindow" AutomationProperties.Name="Levels: names, elevations and heights" ToolTipService.ToolTip="Levels: names, elevations and heights" Style="{StaticResource IconButtonStyle}">
                            <local:DrawnIcon Kind="gear" />
                        </Button>
                        <TextBlock x:Name="LevelHint" VerticalAlignment="Center" Margin="{StaticResource PaddingMd}" FontSize="{StaticResource FontSizeCaption}" Opacity="0.7" AutomationProperties.Name="Level mode" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            </Grid>
            <local:ResizeGrip x:Name="LeftSplitter" Grid.Column="2" Width="{StaticResource SplitterWidth}" MinWidth="{StaticResource SplitterWidth}" Background="{ThemeResource BorderDefaultBrush}" PointerPressed="OnSplitPressed" PointerMoved="OnSplitMoved" PointerReleased="OnSplitReleased" PointerCaptureLost="OnSplitCaptureLost" KeyDown="OnSplitKey" AutomationProperties.Name="Resize side panel" ToolTipService.ToolTip="Drag, or Left and Right arrows when focused" />
            <Border x:Name="SideHost" Grid.Column="3" Style="{StaticResource SidePanelChromeStyle}" BorderThickness="1,0,0,0" PointerEntered="OnColumnEntered" PointerExited="OnColumnExited">
            <!-- The open panel, then a rail of panel titles that is always visible (open or collapsed). -->
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource SideRailColumnWidth}" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="LeftColumn" Tag="right" AutomationProperties.Name="Side panel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="{StaticResource PaddingPanelTight}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="SidePanelTitle"
                        Text="Properties"
                        FontSize="{StaticResource FontSizeBody}"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Panel title" />
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="{StaticResource SpaceSm}"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right">
                        <Button x:Name="FloatLeftButton" Style="{StaticResource IconButtonStyle}" Click="OnFloat" AutomationProperties.Name="Float side panels" ToolTipService.ToolTip="Float side panels">
                            <local:DrawnIcon Kind="float" Width="{StaticResource IconSize}" Height="{StaticResource IconSize}" />
                        </Button>
                        <Button x:Name="PinLeftButton" Style="{StaticResource IconButtonStyle}" Click="OnPin" AutomationProperties.Name="Pin side panel" ToolTipService.ToolTip="Pin side panel">
                            <local:DrawnIcon Kind="pin" Width="{StaticResource IconSize}" Height="{StaticResource IconSize}" />
                        </Button>
                    </StackPanel>
                </Grid>
                <!-- One panel at a time; the rail chooses which. -->
                <Grid x:Name="SideTabs" Grid.Row="1">
                    <Grid x:Name="PropertiesTab" AutomationProperties.Name="Properties">
                        <ScrollViewer x:Name="PropertiesHost">
                            <StackPanel x:Name="PropertiesPanel" Margin="{StaticResource PaddingPanel}" Spacing="{StaticResource SpaceXs}" />
                        </ScrollViewer>
                    </Grid>
                    <Grid x:Name="LayersTab" Visibility="Collapsed" AutomationProperties.Name="Layers">
                        <Grid x:Name="LayersSlot">
                            <ScrollViewer x:Name="LayersHost">
                                <StackPanel x:Name="LayersPanel" Margin="{StaticResource PaddingPanel}" Spacing="{StaticResource SpaceXs}" />
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                    <Grid x:Name="BlocksTab" Visibility="Collapsed" AutomationProperties.Name="Blocks">
                        <ScrollViewer x:Name="BlocksHost">
                            <StackPanel x:Name="BlocksPanel" Margin="{StaticResource PaddingPanel}" Spacing="{StaticResource SpaceXs}" />
                        </ScrollViewer>
                    </Grid>
                    <Grid x:Name="ProjectTab" Visibility="Collapsed" AutomationProperties.Name="Project settings">
                        <ScrollViewer x:Name="ProjectHost">
                            <StackPanel x:Name="ProjectPanel" Margin="{StaticResource PaddingPanel}" Spacing="{StaticResource SpaceXs}" />
                        </ScrollViewer>
                    </Grid>
                    <Grid x:Name="HistoryTab" Visibility="Collapsed" AutomationProperties.Name="History">
                        <Grid x:Name="HistoryHost" Margin="{StaticResource PaddingPanel}" />
                    </Grid>
                    <Grid x:Name="RevisionsTab" Visibility="Collapsed" AutomationProperties.Name="Revisions">
                        <Grid x:Name="RevisionsHost" Margin="{StaticResource PaddingPanel}" />
                    </Grid>
                </Grid>
            </Grid>
            <Border
                x:Name="SideRail"
                Grid.Column="1"
                Width="{StaticResource SideRailWidth}"
                Background="{ThemeResource SurfaceSecondaryBrush}"
                BorderBrush="{ThemeResource BorderSubtleBrush}"
                BorderThickness="0"
                AutomationProperties.Name="Panel titles">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SideRailTabs" Orientation="Vertical" Spacing="{StaticResource SpaceXs}" Margin="0,6,4,6" />
                </ScrollViewer>
            </Border>
            </Grid>
            </Border>
        </Grid>
        <Border
            x:Name="CommandBar"
            Visibility="Collapsed"
            Padding="0"
            Background="Transparent"
            BorderThickness="0"
            PreviewKeyDown="OnAiKey"
            AutomationProperties.Name="AI command prompt">
            <StackPanel Spacing="{StaticResource SpaceMd}" VerticalAlignment="Bottom">
                <!-- Pill input only; height stays content-sized (no empty card below). -->
                <Border
                    x:Name="AskInputPill"
                    Height="{StaticResource AskPillHeight}"
                    MinHeight="{StaticResource AskPillHeight}"
                    MaxHeight="{StaticResource AskPillHeight}"
                    VerticalAlignment="Bottom"
                    CornerRadius="{StaticResource CornerRadiusAskPill}"
                    Background="{ThemeResource SurfaceElevatedBrush}"
                    BorderBrush="{ThemeResource BorderDefaultBrush}"
                    BorderThickness="1"
                    Padding="{StaticResource AskPillPadding}">
                    <Grid ColumnSpacing="{StaticResource SpaceMd}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AskAttach" Visibility="Collapsed" Width="{StaticResource AskAvatarSize}" Height="{StaticResource AskAvatarSize}" MinWidth="0" MinHeight="0" Padding="0" BorderThickness="0" CornerRadius="{StaticResource CornerRadiusAskAvatar}" Background="{ThemeResource SurfaceSecondaryBrush}" VerticalAlignment="Center" Click="OnAskAttach" AutomationProperties.Name="Import a file into the drawing" ToolTipService.ToolTip="Import a file: DXF, DWG, PDF, SVG, PNG, JPEG or TIFF">
                            <FontIcon Glyph="&#xE710;" FontSize="{StaticResource FontSizeBody}" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <TextBox
                            x:Name="AiInput"
                            Grid.Column="1"
                            FontFamily="{StaticResource FontFamilyUi}"
                            FontSize="{StaticResource FontSizeCommand}"
                            MinHeight="{StaticResource FileTabHeight}"
                            BorderThickness="0"
                            CornerRadius="0"
                            Background="Transparent"
                            Padding="{StaticResource PaddingSm}"
                            VerticalAlignment="Center"
                            PlaceholderText="Ask about the drawing…"
                            AutomationProperties.Name="AI prompt">
                            <TextBox.Resources>
                                <!-- One pill only: kill Fluent's second rounded fill plate. -->
                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
                                <CornerRadius x:Key="TextControlCornerRadius">0</CornerRadius>
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                            </TextBox.Resources>
                        </TextBox>
                        <StackPanel x:Name="AssistantButtons" Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" VerticalAlignment="Center" Visibility="Collapsed">
                            <Button Content="Allow" MinHeight="{StaticResource ControlHeight}" MinWidth="{StaticResource TextControlThemeMinWidth}" Click="OnAssistantAllow" AutomationProperties.Name="Allow the assistant tool" />
                            <Button Content="Decline" MinHeight="{StaticResource ControlHeight}" MinWidth="{StaticResource TextControlThemeMinWidth}" Click="OnAssistantDecline" AutomationProperties.Name="Decline the assistant tool" />
                        </StackPanel>
                        <Button
                            x:Name="AskSend"
                            Visibility="Collapsed"
                            Grid.Column="3"
                            Width="{StaticResource AskSendButtonSize}"
                            Height="{StaticResource AskSendButtonSize}"
                            MinWidth="{StaticResource AskSendButtonSize}"
                            MinHeight="{StaticResource AskSendButtonSize}"
                            Padding="0"
                            CornerRadius="{StaticResource CornerRadiusAskSend}"
                            Background="{ThemeResource TextPrimaryBrush}"
                            BorderThickness="0"
                            Click="OnAskSend"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Send ask"
                            ToolTipService.ToolTip="Send">
                            <FontIcon Glyph="&#xE898;" FontSize="{StaticResource FontSizeIcon}" Foreground="{ThemeResource AppBackgroundBrush}" />
                        </Button>
                    </Grid>
                </Border>
                <ListView
                    x:Name="HistoryList"
                    MaxHeight="{StaticResource HistoryListMaxHeight}"
                    Visibility="Collapsed"
                    Background="{ThemeResource SurfaceElevatedBrush}"
                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusAskCard}"
                    FontFamily="{StaticResource FontFamilyUi}"
                    FontSize="{StaticResource FontSizeBody}"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="OnHistoryPick"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    AutomationProperties.Name="Command history list">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource CompactListViewItemStyle}">
                            <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="Padding" Value="10,6" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
                <!-- Hidden: status / a11y / history wiring kept for code paths. -->
                <TextBlock x:Name="PromptLabel" Visibility="Collapsed" Text="Ask" />
                <TextBlock x:Name="History" Visibility="Collapsed" />
                <TextBlock x:Name="Recent0" Visibility="Collapsed" />
                <TextBlock x:Name="Recent1" Visibility="Collapsed" />
                <TextBlock x:Name="QueuedHeader" Visibility="Collapsed" />
                <TextBlock x:Name="QueuedPillLabel" Visibility="Collapsed" />
                <TextBlock x:Name="QueuedPillCount" Visibility="Collapsed" />
                <Border x:Name="RecentCard" Visibility="Collapsed">
                    <Grid x:Name="RecentHost" />
                </Border>
                <Border x:Name="AskPill" Visibility="Collapsed" />
                <Button x:Name="HistoryToggle" Visibility="Collapsed" Click="OnHistoryToggle" />
                <Button x:Name="ClearHistory" Visibility="Collapsed" Click="OnClearHistory" />
                <FontIcon x:Name="HistoryGlyph" Visibility="Collapsed" Glyph="&#xE70D;" />
            </StackPanel>
        </Border>
        <Border Grid.Row="5" Background="{ThemeResource SurfaceStatusBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="{StaticResource PaddingStatus}">
        <Grid x:Name="StatusRow" Style="{StaticResource StatusBarStyle}" ColumnSpacing="{StaticResource SpaceSm}" AutomationProperties.Name="Status">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                                        <TextBlock x:Name="Coords" VerticalAlignment="Center" Margin="{StaticResource MarginGroupStart}" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeMono}" AutomationProperties.Name="Cursor coordinates" />
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                <ToggleButton x:Name="SnapButton" Tag="osnap" Click="OnMode" AutomationProperties.Name="Object snap (F3)" ToolTipService.ToolTip="Object snap (F3)" Style="{StaticResource IconToggleButtonStyle}">
                    <local:DrawnIcon Kind="osnap" />
                </ToggleButton>
                <ToggleButton x:Name="OrthoButton" Tag="ortho" Click="OnMode" AutomationProperties.Name="Ortho mode (F8)" ToolTipService.ToolTip="Ortho (F8)" Style="{StaticResource IconToggleButtonStyle}">
                    <local:DrawnIcon Kind="ortho" />
                </ToggleButton>
                <ToggleButton x:Name="PolarButton" Tag="polar" Click="OnMode" AutomationProperties.Name="Polar tracking (F10)" ToolTipService.ToolTip="Polar tracking (F10)" Style="{StaticResource IconToggleButtonStyle}">
                    <local:DrawnIcon Kind="polar" />
                </ToggleButton>
                <ToggleButton x:Name="TrackButton" Tag="otrack" Click="OnMode" AutomationProperties.Name="Object snap tracking (F11)" ToolTipService.ToolTip="Object snap tracking (F11)" Style="{StaticResource IconToggleButtonStyle}">
                    <local:DrawnIcon Kind="otrack" />
                </ToggleButton>
                <ToggleButton x:Name="DynButton" Tag="dynmode" Click="OnMode" AutomationProperties.Name="Dynamic input (F12)" ToolTipService.ToolTip="Dynamic input (F12)" Style="{StaticResource IconToggleButtonStyle}">
                    <local:DrawnIcon Kind="dyn" />
                </ToggleButton>
                <ToggleButton x:Name="WeightButton" Tag="lwdisplay" Click="OnMode" AutomationProperties.Name="Show lineweight" ToolTipService.ToolTip="Lineweight" Style="{StaticResource IconToggleButtonStyle}">
                    <local:DrawnIcon Kind="lineweight" />
                </ToggleButton>
                <ToggleButton x:Name="TransparencyButton" Tag="transparencydisplay" Click="OnMode" AutomationProperties.Name="Show transparency" ToolTipService.ToolTip="Transparency" Style="{StaticResource IconToggleButtonStyle}">
                    <local:DrawnIcon Kind="transparency" />
                </ToggleButton>
                <ToggleButton x:Name="QuickButton" Tag="qpmode" Click="OnMode" AutomationProperties.Name="Quick properties" ToolTipService.ToolTip="Quick properties" Style="{StaticResource IconToggleButtonStyle}">
                    <local:DrawnIcon Kind="quickprops" />
                </ToggleButton>
                <ComboBox
                    x:Name="UnitsBox"
                    MinWidth="{StaticResource TextControlThemeMinWidth}"
                    MinHeight="{StaticResource ControlHeight}"
                    FontSize="{StaticResource FontSizeBody}"
                    PlaceholderText="units?"
                    SelectionChanged="OnUnitsPicked"
                    AutomationProperties.Name="Drafting units"
                    ToolTipService.ToolTip="Drafting units. Geometry is stored in these units; scale at plot." />

                <Button x:Name="LayersButton" Click="OnLayers" AutomationProperties.Name="Open layer manager" ToolTipService.ToolTip="Layers" Style="{StaticResource IconButtonStyle}">
                    <local:DrawnIcon Kind="layers" />
                </Button>
                <Button
                    x:Name="PdfButton"
                    Click="OnPlotPreview"
                    AutomationProperties.Name="Plot preview"
                    ToolTipService.ToolTip="Plot preview — pick a window, then preview the nameplate PDF"
                    Style="{StaticResource IconButtonStyle}">
                    <local:DrawnIcon Kind="pdf" />
                </Button>
                <Button x:Name="WorkspaceButton" Click="OnWorkspace" AutomationProperties.Name="Classic or Pro workspace" ToolTipService.ToolTip="Classic" Style="{StaticResource IconButtonStyle}">
                    <local:DrawnIcon Kind="workspace" />
                </Button>
                <Button x:Name="ThemeButton" Style="{StaticResource IconButtonStyle}" Click="OnThemeButton" AutomationProperties.Name="Theme" ToolTipService.ToolTip="Dark or light theme">
                    <local:DrawnIcon x:Name="ThemeIcon" Kind="moon" />
                </Button>
                <Border x:Name="AiChipHost" CornerRadius="{StaticResource CornerRadiusButton}" BorderThickness="1.5" BorderBrush="Transparent" VerticalAlignment="Center">
                    <Button x:Name="AiChip" Style="{StaticResource IconButtonStyle}" Click="OnAiChip" AutomationProperties.Name="AI assistant" ToolTipService.ToolTip="AI assistant">
                        <local:DrawnIcon Kind="agent" />
                    </Button>
                </Border>
                <TextBlock x:Name="ControlPort" Visibility="Collapsed" Style="{StaticResource StatusTextStyle}" AutomationProperties.Name="Control channel" />
                <TextBlock x:Name="SaveState" Visibility="Collapsed" Style="{StaticResource StatusTextStyle}" AutomationProperties.Name="Save status" />
                <TextBlock x:Name="Status" Style="{StaticResource StatusTextStyle}" AutomationProperties.Name="Drawing status" />
            </StackPanel>
        </Grid>
        </Border>
        <!-- Page layout: the drawing tab's Page layout item shows this panel in a flyout. -->
        <StackPanel x:Name="PageLayoutPanel" Visibility="Collapsed" Spacing="{StaticResource SpaceMd}" Padding="{StaticResource PaddingMd}" MinWidth="{StaticResource PanelMinWidth}">
            <TextBlock x:Name="PageLayoutTitle" Text="Page layout" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="{StaticResource PanelTitleMaxWidth}" />
            <TextBlock Text="Paper size" FontSize="{StaticResource FontSizeCaption}" Foreground="{ThemeResource TextSecondaryBrush}" />
            <ComboBox
                x:Name="PaperBox"
                MinWidth="{StaticResource DialogActionMinWidth}"
                MinHeight="{StaticResource ControlHeight}"
                FontSize="{StaticResource FontSizeBody}"
                PlaceholderText="Paper"
                SelectionChanged="OnPaperPicked"
                AutomationProperties.Name="Page size"
                ToolTipService.ToolTip="ISO page size (A0–A4) for the nameplate" />
            <TextBlock Text="Orientation" FontSize="{StaticResource FontSizeCaption}" Foreground="{ThemeResource TextSecondaryBrush}" />
            <ComboBox
                x:Name="OrientBox"
                MinWidth="{StaticResource OrientComboMinWidth}"
                MinHeight="{StaticResource ControlHeight}"
                FontSize="{StaticResource FontSizeBody}"
                SelectionChanged="OnOrientPicked"
                AutomationProperties.Name="Page orientation"
                ToolTipService.ToolTip="Landscape or portrait for the nameplate" />
            <TextBlock Text="Scale" FontSize="{StaticResource FontSizeCaption}" Foreground="{ThemeResource TextSecondaryBrush}" />
            <ComboBox
                x:Name="ScaleBox"
                MinWidth="{StaticResource OrientComboMinWidth}"
                MinHeight="{StaticResource ControlHeight}"
                FontSize="{StaticResource FontSizeBody}"
                SelectionChanged="OnScalePicked"
                AutomationProperties.Name="Sheet scale"
                ToolTipService.ToolTip="The scale of this tab's sheet: 1 mm on paper is this many millimetres of the building" />
            <Button
                x:Name="NameplateButton"
                Content="Nameplate"
                MinHeight="{StaticResource ControlHeight}"
                FontSize="{StaticResource FontSizeCaption}"
                Padding="{StaticResource PaddingControl}"
                Click="OnNameplateMenu"
                AutomationProperties.Name="Nameplate designer"
                ToolTipService.ToolTip="Design Nameplate L (landscape) or Nameplate P (portrait)" />
        </StackPanel>
        <!-- Welcome: shown after splash until New / Open / Project Wizard (or a launch file opens). -->
        <Grid
            x:Name="WelcomeOverlay"
            Grid.Row="3"
            Visibility="Collapsed"
            Background="{ThemeResource AppBackgroundBrush}"
            Canvas.ZIndex="400"
            AutomationProperties.Name="Welcome">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel
                    MaxWidth="{StaticResource WelcomeMaxWidth}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="{StaticResource MarginWelcomePanel}"
                    Spacing="{StaticResource SpaceLg}">
                    <!-- The lockup artwork has dark text: on the dark theme it sits on a light plate. -->
                    <Border HorizontalAlignment="Left" CornerRadius="{StaticResource CornerRadiusControl}" Padding="{StaticResource PaddingLg}" Background="{ThemeResource LockupPlateBrush}">
                        <Image x:Name="WelcomeLogo" MaxWidth="{StaticResource WelcomeLogoMaxWidth}" HorizontalAlignment="Left" Stretch="Uniform" AutomationProperties.Name="MynaCAD" />
                    </Border>
                    <TextBlock
                        Text="Start a drawing or open the project file (.osp) shared with MynaOps. Company details for title blocks come from a file exported in MynaHub."
                        TextWrapping="WrapWholeWords"
                        FontSize="{StaticResource FontSizeBody}"
                        Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock
                        Text="Developed by Human Centric Works"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{ThemeResource TextSecondaryBrush}" />
                    <StackPanel Spacing="{StaticResource SpaceSm}" HorizontalAlignment="Stretch">
                        <Button
                            Content="New drawing"
                            Style="{StaticResource PrimaryActionStyle}"
                            HorizontalAlignment="Stretch"
                            MinHeight="{StaticResource DialogButtonHeight}"
                            Click="OnWelcomeNew"
                            AutomationProperties.Name="New drawing"
                            AutomationProperties.AutomationId="welcome.new" />
                        <Button
                            Content="Open drawing…"
                            HorizontalAlignment="Stretch"
                            MinHeight="{StaticResource DialogButtonHeight}"
                            Click="OnWelcomeOpen"
                            AutomationProperties.Name="Open drawing"
                            AutomationProperties.AutomationId="welcome.open" />
                        <Button
                            Content="Import company details…"
                            HorizontalAlignment="Stretch"
                            MinHeight="{StaticResource DialogButtonHeight}"
                            Click="OnWelcomeCompanyPack"
                            AutomationProperties.Name="Import company details"
                            AutomationProperties.AutomationId="welcome.company" />
                        <Button
                            Content="Project Wizard…"
                            HorizontalAlignment="Stretch"
                            MinHeight="{StaticResource DialogButtonHeight}"
                            Click="OnWelcomeWizard"
                            AutomationProperties.Name="Project Wizard"
                            AutomationProperties.AutomationId="welcome.wizard" />
                    </StackPanel>
                    <StackPanel Spacing="{StaticResource SpaceXs}">
                        <TextBlock
                            Text="Recent"
                            FontSize="{StaticResource FontSizeCaption}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            AutomationProperties.HeadingLevel="Level2" />
                        <StackPanel x:Name="WelcomeRecent" Spacing="{StaticResource SpaceXs}" AutomationProperties.Name="Recent drawings" />
                        <TextBlock
                            x:Name="WelcomeRecentEmpty"
                            Text="No recent drawings yet."
                            FontSize="{StaticResource FontSizeCaption}"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <!-- Open / save progress over the canvas (worker-thread file IO). -->
        <Grid
            x:Name="BusyOverlay"
            Grid.Row="3"
            Visibility="Collapsed"
            Background="#99000000"
            Canvas.ZIndex="500"
            AutomationProperties.Name="File progress">
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SurfaceElevatedBrush}"
                BorderBrush="{ThemeResource BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadiusAskCard}"
                Padding="{StaticResource BusyCardPadding}"
                MinWidth="{StaticResource BusyCardMinWidth}"
                MaxWidth="{StaticResource StatusMaxWidth}">
                <StackPanel Spacing="{StaticResource SpaceMd}" HorizontalAlignment="Center">
                    <ProgressRing
                        x:Name="BusyRing"
                        Width="{StaticResource BusyRingSize}"
                        Height="{StaticResource BusyRingSize}"
                        IsActive="False"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        x:Name="BusyTitle"
                        Text="Working…"
                        FontSize="{StaticResource FontSizeSection}"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        TextWrapping="Wrap"
                        TextAlignment="Center" />
                    <TextBlock
                        x:Name="BusyDetail"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        HorizontalAlignment="Center"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        />
                </StackPanel>
            </Border>
        </Grid>
        <!-- In-window splash (avoids a second top-level window fighting the command chrome). -->
        <Grid x:Name="SplashOverlay" Grid.RowSpan="6" Background="{ThemeResource SplashBackgroundBrush}" Canvas.ZIndex="1000" AutomationProperties.Name="Splash">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource SpaceMd}">
                <Image x:Name="SplashLogo" Width="{StaticResource LogoSplash}" Height="{StaticResource LogoSplash}" HorizontalAlignment="Center" AutomationProperties.Name="MynaCAD" />
                <TextBlock Text="MynaCAD" FontSize="{StaticResource FontSizeSplashTitle}" FontWeight="SemiBold" Foreground="{ThemeResource SplashForegroundBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Architectural drafting with MynaHub and MynaOps" FontSize="{StaticResource FontSizeSection}" Foreground="{ThemeResource SplashForegroundBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Myna · with MynaHub and MynaOps" FontSize="{StaticResource FontSizeBody}" Foreground="{ThemeResource SplashForegroundBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Open source · MIT OR Apache-2.0" FontSize="{StaticResource FontSizeBody}" Foreground="{ThemeResource SplashForegroundBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
