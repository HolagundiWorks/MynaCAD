<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Premium CAD + Fluent surfaces. The neutrals, the accent and the Fluent system-control overrides come from the shared O.Ui theme
      (SuiteLight.Mirage / SuiteDark.Mirage), so stock WinUI controls (Expander, ListView, TextBox, NavigationView, ...) take the suite colours;
      what is left here are MynaCAD's own keys, with the suite palette values written out (a Color alias would resolve in the wrong theme when read from code), and the CAD chrome that stays independent.
      Dark: graphite/charcoal. Light: neutral off-white.
      Accent: Midnight #102C80 (brand guide, docs/BRANDING.md): ink and accent in light, a lighter Midnight tint in dark. Canvas stays independently black/white.
      Command chrome stays opaque (no acrylic) so the HWND drawing child stays readable.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///O.Ui/Themes/SuiteLight.Mirage.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Suite glass soft-UI (aligned with O.Ui SuiteColors). Canvas stays white. -->
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="LockupPlateBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#4D4D4D" />
            <SolidColorBrush x:Key="AccentBrush" Color="#102C80" />
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ControlHoverBrush" Color="#F0F0F0" />
            <SolidColorBrush x:Key="ControlPressedBrush" Color="#D9D9D9" />
            <SolidColorBrush x:Key="ControlSelectedBrush" Color="#E4E8F8" />
            <SolidColorBrush x:Key="FocusBorderBrush" Color="#102C80" />
            <SolidColorBrush x:Key="ControlDisabledBrush" Color="#767676" />
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CommandChromeBrush" Color="#FAFFFFFF" />
            <SolidColorBrush x:Key="CommandChromeCadBrush" Color="#FAEEF2F8" />
            <SolidColorBrush x:Key="CommandChromeAccentBrush" Color="#102C80" />
            <SolidColorBrush x:Key="CadChannelBrush" Color="#0F7B3A" />
            <SolidColorBrush x:Key="SplashBackgroundBrush" Color="#102C80" />
            <SolidColorBrush x:Key="SplashForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B3A" />
            <SolidColorBrush x:Key="WarningBrush" Color="#9A6700" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="DestructiveBrush" Color="#C42B1C" />
            <Color x:Key="TitleBarBackgroundColor">#FFFFFF</Color>
            <Color x:Key="TitleBarForegroundColor">#000000</Color>
            <Color x:Key="TitleBarInactiveForegroundColor">#4D4D4D</Color>
            <Color x:Key="TitleBarHoverColor">#F0F0F0</Color>
            <Color x:Key="TitleBarPressedColor">#D9D9D9</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Default">
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///O.Ui/Themes/SuiteDark.Mirage.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#000000" />
            <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#000000" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#B8B8B8" />
            <SolidColorBrush x:Key="AccentBrush" Color="#6B8FD8" />
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#0B1020" />
            <SolidColorBrush x:Key="ControlHoverBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="ControlPressedBrush" Color="#333333" />
            <SolidColorBrush x:Key="ControlSelectedBrush" Color="#2A3F66" />
            <SolidColorBrush x:Key="FocusBorderBrush" Color="#6B8FD8" />
            <SolidColorBrush x:Key="ControlDisabledBrush" Color="#8C8C8C" />
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#000000" />
            <SolidColorBrush x:Key="LockupPlateBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CommandChromeBrush" Color="#F2151922" />
            <SolidColorBrush x:Key="CommandChromeCadBrush" Color="#F21B1F28" />
            <SolidColorBrush x:Key="CommandChromeAccentBrush" Color="#6F8FF0" />
            <SolidColorBrush x:Key="CadChannelBrush" Color="#6CCB8A" />
            <SolidColorBrush x:Key="SplashBackgroundBrush" Color="#000000" />
            <SolidColorBrush x:Key="SplashForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB8A" />
            <SolidColorBrush x:Key="WarningBrush" Color="#F0C36A" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#F87171" />
            <SolidColorBrush x:Key="DestructiveBrush" Color="#F87171" />
            <Color x:Key="TitleBarBackgroundColor">#000000</Color>
            <Color x:Key="TitleBarForegroundColor">#FFFFFF</Color>
            <Color x:Key="TitleBarInactiveForegroundColor">#B8B8B8</Color>
            <Color x:Key="TitleBarHoverColor">#1F1F1F</Color>
            <Color x:Key="TitleBarPressedColor">#333333</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///O.Ui/Themes/SuiteDark.Mirage.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#000000" />
            <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#000000" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#B8B8B8" />
            <SolidColorBrush x:Key="AccentBrush" Color="#6B8FD8" />
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#0B1020" />
            <SolidColorBrush x:Key="ControlHoverBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="ControlPressedBrush" Color="#333333" />
            <SolidColorBrush x:Key="ControlSelectedBrush" Color="#2A3F66" />
            <SolidColorBrush x:Key="FocusBorderBrush" Color="#6B8FD8" />
            <SolidColorBrush x:Key="ControlDisabledBrush" Color="#8C8C8C" />
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#000000" />
            <SolidColorBrush x:Key="LockupPlateBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CommandChromeBrush" Color="#F2151922" />
            <SolidColorBrush x:Key="CommandChromeCadBrush" Color="#F21B1F28" />
            <SolidColorBrush x:Key="CommandChromeAccentBrush" Color="#6F8FF0" />
            <SolidColorBrush x:Key="CadChannelBrush" Color="#6CCB8A" />
            <SolidColorBrush x:Key="SplashBackgroundBrush" Color="#000000" />
            <SolidColorBrush x:Key="SplashForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB8A" />
            <SolidColorBrush x:Key="WarningBrush" Color="#F0C36A" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#F87171" />
            <SolidColorBrush x:Key="DestructiveBrush" Color="#F87171" />
            <Color x:Key="TitleBarBackgroundColor">#000000</Color>
            <Color x:Key="TitleBarForegroundColor">#FFFFFF</Color>
            <Color x:Key="TitleBarInactiveForegroundColor">#B8B8B8</Color>
            <Color x:Key="TitleBarHoverColor">#1F1F1F</Color>
            <Color x:Key="TitleBarPressedColor">#333333</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
