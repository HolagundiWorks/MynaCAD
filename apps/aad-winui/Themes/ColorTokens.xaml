<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Premium CAD + Fluent surfaces.
      Dark: graphite/charcoal. Light: neutral off-white.
      Accent: Midnight #102C80 (brand guide, docs/BRANDING.md): ink and accent in light, a lighter Midnight tint in dark. Canvas stays independently black/white.
      Command chrome stays opaque (no acrylic) so the HWND drawing child stays readable.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- Suite glass soft-UI (aligned with O.Ui SuiteColors). Canvas stays white. -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#E4EAF2" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#EEF2F8" />
            <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#F1F5FA" />
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceStatusBrush" Color="#EEF2F8" />
            <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#102C80" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#3E56A0" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#546B88" />
            <SolidColorBrush x:Key="BorderDefaultBrush" Color="#D8DEE8" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E4EAF2" />
            <SolidColorBrush x:Key="AccentBrush" Color="#102C80" />
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ControlHoverBrush" Color="#F1F5FA" />
            <SolidColorBrush x:Key="ControlPressedBrush" Color="#D8DEE8" />
            <SolidColorBrush x:Key="ControlSelectedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="FocusBorderBrush" Color="#102C80" />
            <SolidColorBrush x:Key="ControlDisabledBrush" Color="#8F9EC4" />
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CommandChromeBrush" Color="#FAFFFFFF" />
            <SolidColorBrush x:Key="CommandChromeCadBrush" Color="#FAEEF2F8" />
            <SolidColorBrush x:Key="CommandChromeAccentBrush" Color="#102C80" />
            <SolidColorBrush x:Key="CadChannelBrush" Color="#0F7B3A" />
            <SolidColorBrush x:Key="SplashBackgroundBrush" Color="#102C80" />
            <SolidColorBrush x:Key="SplashForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B3A" />
            <SolidColorBrush x:Key="WarningBrush" Color="#9A6700" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="DestructiveBrush" Color="#C42B1C" />
            <Color x:Key="TitleBarBackgroundColor">#E4EAF2</Color>
            <Color x:Key="TitleBarForegroundColor">#102C80</Color>
            <Color x:Key="TitleBarInactiveForegroundColor">#3E56A0</Color>
            <Color x:Key="TitleBarHoverColor">#F1F5FA</Color>
            <Color x:Key="TitleBarPressedColor">#D8DEE8</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1B1B1B" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#202020" />
            <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#2C2C2C" />
            <SolidColorBrush x:Key="SurfaceStatusBrush" Color="#242424" />
            <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#000000" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C8C8C8" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#9A9A9A" />
            <SolidColorBrush x:Key="BorderDefaultBrush" Color="#3D3D3D" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#333333" />
            <SolidColorBrush x:Key="AccentBrush" Color="#6F8FF0" />
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#0B1020" />
            <SolidColorBrush x:Key="ControlHoverBrush" Color="#2F2F2F" />
            <SolidColorBrush x:Key="ControlPressedBrush" Color="#383838" />
            <SolidColorBrush x:Key="ControlSelectedBrush" Color="#1C2A50" />
            <SolidColorBrush x:Key="FocusBorderBrush" Color="#7C9BFF" />
            <SolidColorBrush x:Key="ControlDisabledBrush" Color="#6B6B6B" />
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#2C2C2C" />
            <SolidColorBrush x:Key="CommandChromeBrush" Color="#F21F1F1F" />
            <SolidColorBrush x:Key="CommandChromeCadBrush" Color="#F2282828" />
            <SolidColorBrush x:Key="CommandChromeAccentBrush" Color="#6F8FF0" />
            <SolidColorBrush x:Key="CadChannelBrush" Color="#6CCB8A" />
            <SolidColorBrush x:Key="SplashBackgroundBrush" Color="#141414" />
            <SolidColorBrush x:Key="SplashForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB8A" />
            <SolidColorBrush x:Key="WarningBrush" Color="#F0C36A" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="DestructiveBrush" Color="#FF99A4" />
            <Color x:Key="TitleBarBackgroundColor">#1B1B1B</Color>
            <Color x:Key="TitleBarForegroundColor">#F3F3F3</Color>
            <Color x:Key="TitleBarInactiveForegroundColor">#9A9A9A</Color>
            <Color x:Key="TitleBarHoverColor">#2F2F2F</Color>
            <Color x:Key="TitleBarPressedColor">#383838</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1B1B1B" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#202020" />
            <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#2C2C2C" />
            <SolidColorBrush x:Key="SurfaceStatusBrush" Color="#242424" />
            <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#000000" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C8C8C8" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#9A9A9A" />
            <SolidColorBrush x:Key="BorderDefaultBrush" Color="#3D3D3D" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#333333" />
            <SolidColorBrush x:Key="AccentBrush" Color="#6F8FF0" />
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#0B1020" />
            <SolidColorBrush x:Key="ControlHoverBrush" Color="#2F2F2F" />
            <SolidColorBrush x:Key="ControlPressedBrush" Color="#383838" />
            <SolidColorBrush x:Key="ControlSelectedBrush" Color="#1C2A50" />
            <SolidColorBrush x:Key="FocusBorderBrush" Color="#7C9BFF" />
            <SolidColorBrush x:Key="ControlDisabledBrush" Color="#6B6B6B" />
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#2C2C2C" />
            <SolidColorBrush x:Key="CommandChromeBrush" Color="#F21F1F1F" />
            <SolidColorBrush x:Key="CommandChromeCadBrush" Color="#F2282828" />
            <SolidColorBrush x:Key="CommandChromeAccentBrush" Color="#6F8FF0" />
            <SolidColorBrush x:Key="CadChannelBrush" Color="#6CCB8A" />
            <SolidColorBrush x:Key="SplashBackgroundBrush" Color="#141414" />
            <SolidColorBrush x:Key="SplashForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB8A" />
            <SolidColorBrush x:Key="WarningBrush" Color="#F0C36A" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="DestructiveBrush" Color="#FF99A4" />
            <Color x:Key="TitleBarBackgroundColor">#1B1B1B</Color>
            <Color x:Key="TitleBarForegroundColor">#F3F3F3</Color>
            <Color x:Key="TitleBarInactiveForegroundColor">#9A9A9A</Color>
            <Color x:Key="TitleBarHoverColor">#2F2F2F</Color>
            <Color x:Key="TitleBarPressedColor">#383838</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
