<Application
    x:Class="Aad.WinUi.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Themes/ColorTokens.xaml" />
                <ResourceDictionary Source="Themes/TypographyTokens.xaml" />
                <ResourceDictionary Source="Themes/SpacingTokens.xaml" />
                <ResourceDictionary Source="Themes/ControlTokens.xaml" />
                <ResourceDictionary Source="Themes/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- MynaCAD's accent is Midnight (brand guide): the system accent drives selection, toggles, checkboxes and focus rings.
                 Light uses Midnight #102C80 and its shades; dark uses a lighter tint of it that shows on the dark surfaces. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#102C80</Color>
                    <Color x:Key="SystemAccentColorLight1">#3E56A0</Color>
                    <Color x:Key="SystemAccentColorLight2">#5A72BC</Color>
                    <Color x:Key="SystemAccentColorLight3">#8FA3DC</Color>
                    <Color x:Key="SystemAccentColorDark1">#0C2470</Color>
                    <Color x:Key="SystemAccentColorDark2">#081C60</Color>
                    <Color x:Key="SystemAccentColorDark3">#051448</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColor">#6F8FF0</Color>
                    <Color x:Key="SystemAccentColorLight1">#86A2F5</Color>
                    <Color x:Key="SystemAccentColorLight2">#A3B8F8</Color>
                    <Color x:Key="SystemAccentColorLight3">#C2D0FA</Color>
                    <Color x:Key="SystemAccentColorDark1">#5B7BE0</Color>
                    <Color x:Key="SystemAccentColorDark2">#4A68C8</Color>
                    <Color x:Key="SystemAccentColorDark3">#3A54A8</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
